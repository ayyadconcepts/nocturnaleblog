---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(post => post.id !== 'about-ubirajara-barroso')
  .slice(0, 3);
---

<Layout 
  title="Understanding Nocturnal Enuresis | Dr. Barroso" 
  description="Expert insights and comprehensive information on nocturnal enuresis (bedwetting) by Dr. Ubirajara Barroso, Jr."
>
  <div class="container">
    <section class="hero-section">
      <div class="hero-image-container">
        <!-- Doctor's Photo -->
        <img src="/images/dr-barroso.png" alt="Dr. Ubirajara Barroso, Jr." class="hero-image" />
      </div>
      
      <div class="hero-content">
        <h1 class="hero-title">Hi, I'm Dr. Barroso!<br/>Clinical expert who simplifies bedwetting.</h1>
        <p class="hero-subtitle">
          I <a href="/about">treat patients</a>, conduct <a href="/blog">medical research</a>, and write guides on nocturnal enuresis to help families worldwide.
        </p>
        <a href="/about" class="btn">Contacts</a>
      </div>
    </section>

    <section class="eeat-section">
      <div class="eeat-grid">
        <div class="eeat-card">
          <h2>Medical Expertise You Can Trust</h2>
          <p>This hub is medically reviewed by Dr. Ubirajara Barroso, Jr., a world-renowned pediatric urologist and former President of the International Children's Continence Society (ICCS). Our goal is to provide families with evidence-based, clinical information they can rely on.</p>
        </div>
        <div class="eeat-card">
          <h2>Understanding Nocturnal Enuresis</h2>
          <p>Bedwetting is a physiological medical condition, not a behavioral choice. It involves genetics, sleep arousal disorders, and bladder capacity. We focus on actionable treatments like bedwetting alarms, hypnosis therapies, and structured routines to help children and teens achieve dry nights safely.</p>
        </div>
      </div>
    </section>

    <section class="blog-section">
      <h2 class="section-heading">Blog</h2>
      
      <div class="post-list">
        {recentPosts.map((post) => (
          <div class="post-card">
            <div class="post-card-inner">
              <div class="post-card-header">
                <h3 class="post-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <div class="post-meta">
                  <span class="post-date">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      month: 'long',
                      day: 'numeric',
                      year: 'numeric',
                    })}
                  </span>

                </div>
              </div>
              <p class="post-description">{post.data.description.substring(0, 160)}...</p>
              <a href={`/blog/${post.id}`} class="read-more">Read more &rarr;</a>
            </div>
          </div>
        ))}
      </div>
      <div class="view-all-wrapper">
        <a href="/blog" class="btn">View All Articles</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 2rem 0 6rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-section {
      grid-template-columns: 1fr 1.5fr;
      gap: 4rem;
    }
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 24px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-main);
    margin-bottom: 2.5rem;
    max-width: 500px;
  }

  /* Blog Section */
  .blog-section {
    padding: 4rem 0 6rem;
    border-top: 1px solid var(--surface-light);
  }

  .section-heading {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    background-color: var(--surface-light);
    border-radius: 20px;
    padding: 2.5rem;
    transition: background-color 0.2s ease;
  }
  
  .post-card:hover {
    background-color: var(--surface-hover);
  }

  .post-card-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .post-card-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .post-title {
    font-size: 1.75rem;
    margin: 0;
    max-width: 600px;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .post-tags {
    text-decoration: underline;
    text-decoration-color: var(--text-light);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .post-description {
    font-size: 1rem;
    color: var(--text-main);
    margin: 0;
    max-width: 800px;
    line-height: 1.7;
  }

  .read-more {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: inline-block;
    align-self: flex-start;
  }

  /* View All Button Wrapper */
  .view-all-wrapper {
    margin-top: 3rem;
    text-align: center;
  }

  /* EEAT Section */
  .eeat-section {
    padding: 4rem 0 6rem;
    border-top: 1px solid var(--surface-light);
  }

  .eeat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .eeat-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .eeat-card {
    background-color: var(--surface-light);
    border-radius: 20px;
    padding: 3rem;
  }

  .eeat-card h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .eeat-card p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-main);
  }
</style>
