      </p>
    </div>
  </div>
</Layout>

<style>
  .legal-container {
    max-width: 800px;
    padding: 4rem 2rem 6rem;
  }

  .legal-header {
    margin-bottom: 3rem;
  }

  .legal-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .legal-date {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .legal-content h2 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: var(--text-main);
  }
</style>
