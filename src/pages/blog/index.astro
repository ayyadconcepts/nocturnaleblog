---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// exclude about page from blog index
const posts = allPosts.filter(post => post.id !== 'about-ubirajara-barroso');
---

<Layout 
  title="Blog | Nocturnal Enuresis Information" 
  description="Read the latest articles on bedwetting causes, treatments, and research by Dr. Ubirajara Barroso, Jr."
>
  <div class="container">
    <section class="blog-section">
      <h1 class="section-heading">Blog</h1>
      
      <div class="post-list">
        {posts.map((post) => (
          <div class="post-card">
            <div class="post-card-inner">
              <div class="post-card-header">
                <h2 class="post-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                <div class="post-meta">
                  <span class="post-date">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      month: 'long',
                      day: 'numeric',
                      year: 'numeric',
                    })}
                  </span>

                </div>
              </div>
              <p class="post-description">{post.data.description.substring(0, 160)}...</p>
              <a href={`/blog/${post.id}`} class="read-more">Read more &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .blog-section {
    padding-bottom: 6rem;
    padding-top: 2rem;
  }

  .section-heading {
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    background-color: var(--surface-light);
    border-radius: 20px;
    padding: 2.5rem;
    transition: background-color 0.2s ease;
  }
  
  .post-card:hover {
    background-color: var(--surface-hover);
  }

  .post-card-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .post-card-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .post-title {
    font-size: 1.75rem;
    margin: 0;
    max-width: 600px;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .post-tags {
    text-decoration: underline;
    text-decoration-color: var(--text-light);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .post-description {
    font-size: 1rem;
    color: var(--text-main);
    margin: 0;
    max-width: 800px;
    line-height: 1.7;
  }

  .read-more {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: inline-block;
    align-self: flex-start;
  }
</style>
